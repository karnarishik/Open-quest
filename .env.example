# Gemini API Keys for Multi-Key Rotation Manager (Flash model) # AI Studio automatically injects GEMINI_API_KEY; keys 1, 2, and 3 provide automatic failover and load rotation. GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY" GEMINI_API_KEY_1="REPLACE_WITH_YOUR_GEMINI_API_KEY_1" GEMINI_API_KEY_2="REPLACE_WITH_YOUR_GEMINI_API_KEY_2" GEMINI_API_KEY_3="REPLACE_WITH_YOUR_GEMINI_API_KEY_3"  # Administrator demonstration password (default: 118b) ADMIN_PASSWORD="118b"  # Optional YouTube Data API v3 key (fallback search links provided if absent) YOUTUBE_API_KEY="REPLACE_WITH_YOUR_YOUTUBE_DATA_API_KEY"  # APP_URL: The URL where this applet is hosted. APP_URL="REPLACE_WITH_YOUR_APP_URL"