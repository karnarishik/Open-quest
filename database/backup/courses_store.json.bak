[   {     "id": "course-cs101",     "code": "CS101",     "name": "Introduction to Programming with Python",     "semester": "Semester I",     "description": "First-semester computing fundamentals covering algorithmic thinking, variables, control flow, functions, modular program design, and basic data structures.",     "referenceBooks": [       "Python Crash Course (3rd Edition) by Eric Matthes",       "Think Python: How to Think Like a Computer Scientist by Allen B. Downey (Open-Access)",       "Introduction to Computation and Programming Using Python by John V. Guttag (MIT Press)"     ],     "units": [       {         "id": "unit-101-1",         "unitNumber": 1,         "title": "Algorithmic Problem Solving & Python Basics",         "description": "Computational thinking, Python interpreter, variables, dynamic types, arithmetic expressions, and standard I/O.",         "topics": [           {             "id": "top-101-1-1",             "title": "Computational Thinking & Flow of Execution",             "difficulty": "Easy",             "estimatedHours": 1.5           },           {             "id": "top-101-1-2",             "title": "Variables, Expressions, and Dynamic Data Types",             "difficulty": "Easy",             "estimatedHours": 2           },           {             "id": "top-101-1-3",             "title": "Conditional Branching & Boolean Logic",             "difficulty": "Medium",             "estimatedHours": 2           }         ]       },       {         "id": "unit-101-2",         "unitNumber": 2,         "title": "Loops, Sequences & Data Collections",         "description": "Iteration (while and for loops), strings, lists, tuples, and dictionary lookups.",         "topics": [           {             "id": "top-101-2-1",             "title": "Iterative Loops (For, While) & Loop Invariants",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-101-2-2",             "title": "List Operations, Slicing & Comprehensions",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-101-2-3",             "title": "Dictionaries & Hash Key Mapping",             "difficulty": "Medium",             "estimatedHours": 2           }         ]       },       {         "id": "unit-101-3",         "unitNumber": 3,         "title": "Functions, Modular Design & Recursion",         "description": "Function scopes, parameter passing, return values, recursion principles, and standard library modules.",         "topics": [           {             "id": "top-101-3-1",             "title": "Modular Decomposition & Scope Invariants",             "difficulty": "Medium",             "estimatedHours": 2           },           {             "id": "top-101-3-2",             "title": "Recursive Call Stacks & Base Case Guarantees",             "difficulty": "Hard",             "estimatedHours": 3.5           }         ]       }     ]   },   {     "id": "course-cs201",     "code": "CS201",     "name": "Data Structures and Algorithms",     "semester": "Semester III",     "description": "Foundational computing curriculum covering abstract data types, asymptotic efficiency analysis, linear data structures, tree hierarchies, graph algorithms, and sorting paradigms.",     "referenceBooks": [       "Introduction to Algorithms (4th Edition) by Cormen, Leiserson, Rivest, Stein",       "Open Data Structures (in Pseudocode) by Pat Morin (Free Open-Access)",       "Data Structures & Algorithm Analysis in C++ by Mark Allen Weiss"     ],     "units": [       {         "id": "unit-1",         "unitNumber": 1,         "title": "Introduction to Data Structures",         "description": "Abstract Data Types, Arrays, Memory layout, Time & Space Complexity, Asymptotic Analysis (Big-O, Omega, Theta).",         "topics": [           {             "id": "top-1-1",             "title": "Abstract Data Types (ADT) and Primitive Structures",             "difficulty": "Easy",             "estimatedHours": 1.5           },           {             "id": "top-1-2",             "title": "Asymptotic Notations (Big-O, Omega, Theta)",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-1-3",             "title": "Worst, Average, and Amortized Time Complexity",             "difficulty": "Hard",             "estimatedHours": 3           }         ]       },       {         "id": "unit-2",         "unitNumber": 2,         "title": "Arrays, Linked Lists and Stacks",         "description": "Singly, Doubly, and Circular Linked Lists, Pointer manipulation, Stack operations (Push/Pop), Expression conversion (Infix to Postfix).",         "topics": [           {             "id": "top-2-1",             "title": "Singly & Doubly Linked List Pointer Operations",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-2-2",             "title": "Stack Implementation via Arrays and Linked Lists",             "difficulty": "Medium",             "estimatedHours": 2           },           {             "id": "top-2-3",             "title": "Infix to Postfix Conversion & Expression Evaluation",             "difficulty": "Hard",             "estimatedHours": 3           }         ]       },       {         "id": "unit-3",         "unitNumber": 3,         "title": "Queues and Trees",         "description": "Linear & Circular Queues, Priority Queues, Binary Trees, Binary Search Tree (BST) property, Traversals (Inorder, Preorder, Postorder), AVL Tree balancing.",         "topics": [           {             "id": "top-3-1",             "title": "Circular Queues and Priority Queues",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-3-2",             "title": "Binary Search Tree (BST) Insertion and Deletion",             "difficulty": "Medium",             "estimatedHours": 3           },           {             "id": "top-3-3",             "title": "AVL Trees and Self-Balancing Rotations",             "difficulty": "Hard",             "estimatedHours": 3.5           }         ]       },       {         "id": "unit-4",         "unitNumber": 4,         "title": "Graphs and Graph Algorithms",         "description": "Graph representations (Adjacency Matrix & Lists), BFS, DFS, Dijkstra Single-Source Shortest Path, Minimum Spanning Trees (Prim and Kruskal).",         "topics": [           {             "id": "top-4-1",             "title": "Adjacency Matrix vs Adjacency List Representations",             "difficulty": "Easy",             "estimatedHours": 1.5           },           {             "id": "top-4-2",             "title": "Breadth-First Search (BFS) and Depth-First Search (DFS)",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-4-3",             "title": "Dijkstra Shortest Path and Greedy Invariants",             "difficulty": "Hard",             "estimatedHours": 3.5           }         ]       },       {         "id": "unit-5",         "unitNumber": 5,         "title": "Sorting and Searching",         "description": "Linear and Binary Search, Elementary sorts, Divide-and-Conquer: Merge Sort and Quick Sort, Heap Sort and Lower Bounds.",         "topics": [           {             "id": "top-5-1",             "title": "Binary Search & Boundary Invariants",             "difficulty": "Easy",             "estimatedHours": 1.5           },           {             "id": "top-5-2",             "title": "Merge Sort and Divide-and-Conquer Recurrence",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-5-3",             "title": "Quick Sort Partitioning and Worst-Case Avoidance",             "difficulty": "Hard",             "estimatedHours": 3           }         ]       }     ]   },   {     "id": "course-cs202",     "code": "CS202",     "name": "Database Management Systems",     "semester": "Semester III",     "description": "Relational data modeling, SQL queries, relational calculus, schema normalization (1NF through BCNF), transaction processing, and ACID concurrency control.",     "referenceBooks": [       "Database System Concepts (7th Edition) by Silberschatz, Korth, Sudarshan",       "Fundamentals of Database Systems by Elmasri and Navathe",       "Foundations of Databases by Abiteboul, Hull, Vianu (Alice Book - Open Access)"     ],     "units": [       {         "id": "unit-202-1",         "unitNumber": 1,         "title": "Introduction and Conceptual Modeling",         "description": "Database architecture, 3-level schema, Entity-Relationship (ER) diagram modeling, keys and attributes.",         "topics": [           {             "id": "top-202-1-1",             "title": "Database Architecture & Data Independence",             "difficulty": "Easy",             "estimatedHours": 2           },           {             "id": "top-202-1-2",             "title": "Entity-Relationship (ER) Modeling",             "difficulty": "Medium",             "estimatedHours": 3           }         ]       },       {         "id": "unit-202-2",         "unitNumber": 2,         "title": "Relational Model and SQL",         "description": "Relational algebra operations, SQL DDL, DML, complex joins, subqueries, and views.",         "topics": [           {             "id": "top-202-2-1",             "title": "Relational Algebra Operators and Selection",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-202-2-2",             "title": "Advanced SQL Joins and Aggregation",             "difficulty": "Medium",             "estimatedHours": 3           }         ]       },       {         "id": "unit-202-3",         "unitNumber": 3,         "title": "Relational Database Normalization",         "description": "Functional dependencies, Armstrong axioms, 1NF, 2NF, 3NF, and Boyce-Codd Normal Form (BCNF).",         "topics": [           {             "id": "top-202-3-1",             "title": "Functional Dependencies and Attribute Closures",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-202-3-2",             "title": "Normalization to 3NF and BCNF Decompositions",             "difficulty": "Hard",             "estimatedHours": 3.5           }         ]       },       {         "id": "unit-202-4",         "unitNumber": 4,         "title": "Transaction Processing & ACID Properties",         "description": "Transaction states, ACID guarantees, serializability, conflict serializability, two-phase locking (2PL).",         "topics": [           {             "id": "top-202-4-1",             "title": "ACID Properties and Transaction Lifecycle",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-202-4-2",             "title": "Concurrency Control and Strict Two-Phase Locking",             "difficulty": "Hard",             "estimatedHours": 3.5           }         ]       }     ]   },   {     "id": "course-cs489",     "code": "CS489",     "name": "Computer Networks and Protocols",     "semester": "Semester IV",     "description": "Comprehensive study of computer networking architectures, OSI 7-layer model, TCP/IP protocol suite, data link framing, routing algorithms, transport layer flow control, and network security.",     "referenceBooks": [       "Computer Networking: A Top-Down Approach by Kurose and Ross",       "Computer Networks (5th Edition) by Andrew S. Tanenbaum",       "TCP/IP Illustrated, Volume 1: The Protocols by W. Richard Stevens"     ],     "units": [       {         "id": "unit-489-1",         "unitNumber": 1,         "title": "Network Architecture & Physical Layer",         "description": "Network edge and core, packet switching vs circuit switching, OSI 7-layer reference model, TCP/IP stack, transmission media, and delay/loss bounds.",         "topics": [           {             "id": "top-489-1-1",             "title": "OSI 7-Layer Model vs TCP/IP Protocol Stack",             "difficulty": "Easy",             "estimatedHours": 1.5           },           {             "id": "top-489-1-2",             "title": "Packet Switching vs Circuit Switching & Statistical Multiplexing",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-489-1-3",             "title": "Transmission Media, Propagation Delay & Throughput Bounds",             "difficulty": "Medium",             "estimatedHours": 2           }         ]       },       {         "id": "unit-489-2",         "unitNumber": 2,         "title": "Data Link Layer & Local Area Networks",         "description": "Framing, error detection and correction (Parity, Checksum, CRC), flow control protocols, multiple access (CSMA/CD, CSMA/CA), and Ethernet switching.",         "topics": [           {             "id": "top-489-2-1",             "title": "Framing Techniques & Cyclic Redundancy Check (CRC) Error Detection",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-489-2-2",             "title": "Sliding Window Flow Control Protocols (Stop-and-Wait, Go-Back-N, Selective Repeat)",             "difficulty": "Hard",             "estimatedHours": 3.5           },           {             "id": "top-489-2-3",             "title": "Carrier Sense Multiple Access (CSMA/CD) & Collision Avoidance",             "difficulty": "Medium",             "estimatedHours": 2.5           }         ]       },       {         "id": "unit-489-3",         "unitNumber": 3,         "title": "Network Layer & Routing Protocols",         "description": "Virtual circuit vs datagram networks, IP addressing (IPv4, IPv6, Subnetting, CIDR), NAT, routing algorithms (Dijkstra Link-State, Bellman-Ford Distance Vector), BGP, and OSPF.",         "topics": [           {             "id": "top-489-3-1",             "title": "IPv4 / IPv6 Hierarchical Addressing, Subnetting & CIDR Calculation",             "difficulty": "Easy",             "estimatedHours": 2           },           {             "id": "top-489-3-2",             "title": "Dijkstra Link-State vs Bellman-Ford Distance Vector Routing",             "difficulty": "Hard",             "estimatedHours": 3.5           },           {             "id": "top-489-3-3",             "title": "Intra-AS & Inter-AS Routing Paradigms (OSPF, RIP, and BGP)",             "difficulty": "Hard",             "estimatedHours": 3           }         ]       },       {         "id": "unit-489-4",         "unitNumber": 4,         "title": "Transport Layer & Congestion Control",         "description": "Multiplexing and demultiplexing, UDP connectionless delivery, TCP 3-way handshake, connection teardown, TCP reliable data transfer, flow control, and TCP Reno/Tahoe congestion control.",         "topics": [           {             "id": "top-489-4-1",             "title": "User Datagram Protocol (UDP) Architecture & Checksum Verification",             "difficulty": "Easy",             "estimatedHours": 1.5           },           {             "id": "top-489-4-2",             "title": "TCP 3-Way Handshake, Connection Teardown & Sequence Tracking",             "difficulty": "Medium",             "estimatedHours": 2.5           },           {             "id": "top-489-4-3",             "title": "TCP Congestion Control (Slow Start, Additive Increase, Multiplicative Decrease)",             "difficulty": "Hard",             "estimatedHours": 3.5           }         ]       },       {         "id": "unit-489-5",         "unitNumber": 5,         "title": "Application Layer & Network Security",         "description": "DNS resolution hierarchy, HTTP/1.1 vs HTTP/2 vs HTTP/3, SMTP email architecture, symmetric/asymmetric encryption, SSL/TLS handshakes, and firewall architectures.",         "topics": [           {             "id": "top-489-5-1",             "title": "Domain Name System (DNS) Hierarchical Architecture & Query Caching",             "difficulty": "Easy",             "estimatedHours": 1.5           },           {             "id": "top-489-5-2",             "title": "HyperText Transfer Protocol Evolution (HTTP/1.1, HTTP/2, and HTTP/3 QUIC)",             "difficulty": "Medium",             "estimatedHours": 2           },           {             "id": "top-489-5-3",             "title": "SSL/TLS Cryptographic Handshake & Public Key Infrastructure (PKI)",             "difficulty": "Hard",             "estimatedHours": 3           }         ]       }     ]   } ]