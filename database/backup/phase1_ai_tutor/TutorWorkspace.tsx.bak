import React, { useState, useRef, useEffect, useCallback } from 'react'; import { Course, ChatMessage, AgentExecutionStep, User } from '../types'; import { MarkdownRenderer } from './MarkdownRenderer'; import {   Send,   BrainCircuit,   User as UserIcon,   Trash2,   Copy,   Check,   Sparkles,   HelpCircle,   Code2,   ArrowRight,   ShieldAlert,   ChevronDown,   ChevronUp,   FileQuestion,   Layers,   Loader2,   RotateCcw,   AlertTriangle,   X, } from 'lucide-react';  interface TutorWorkspaceProps {   user: User;   course: Course;   initialPrompt?: string;   onClearInitialPrompt?: () => void;   onNavigateToQuiz?: () => void; }  export const TutorWorkspace: React.FC<TutorWorkspaceProps> = ({   user,   course,   initialPrompt,   onClearInitialPrompt,   onNavigateToQuiz, }) => {   const [selectedUnitId, setSelectedUnitId] = useState<string>('all');   const [messages, setMessages] = useState<ChatMessage[]>([]);   const [inputQuery, setInputQuery] = useState(initialPrompt || '');   const [isLoading, setIsLoading] = useState(false);   const [isRetrievingHistory, setIsRetrievingHistory] = useState(true);   const [copiedId, setCopiedId] = useState<string | null>(null);   const [activePipelineSteps, setActivePipelineSteps] = useState<AgentExecutionStep[]>([]);   const [expandedTraceIds, setExpandedTraceIds] = useState<Record<string, boolean>>({});   const [isClearModalOpen, setIsClearModalOpen] = useState(false);   const [isClearing, setIsClearing] = useState(false);    // References to guard against race conditions during rapid course/unit switching   const latestFetchId = useRef<number>(0);   const currentScopeRef = useRef<{ courseId: string; unitId: string }>({     courseId: course.id,     unitId: 'all',   });   const messagesEndRef = useRef<HTMLDivElement>(null);    // Keep scope ref synchronized   useEffect(() => {     currentScopeRef.current = { courseId: course.id, unitId: selectedUnitId };   }, [course.id, selectedUnitId]);    const toggleTrace = (msgId: string) => {     setExpandedTraceIds((prev) => ({ ...prev, [msgId]: !prev[msgId] }));   };    // Helper to generate unit-specific welcome message   const getWelcomeMessage = useCallback(     (c: Course, uId: string): ChatMessage => {       const activeUnit = uId !== 'all' ? c.units.find((u) => u.id === uId) : null;       const unitLabel = activeUnit ? `Unit ${activeUnit.unitNumber}: ${activeUnit.title}` : 'Full Course Curriculum';       return {         id: `welcome-${c.id}-${uId}`,         role: 'assistant',         content: `Welcome! I am your Academic Tutor Agent for **${c.code}: ${c.name}**.\n\nActive Scope: **${unitLabel}**.\n\nAll explanations are strictly grounded in your syllabus. What would you like to explore or solve today?`,         timestamp: 'Just now',       };     },     []   );    // Fetch persistent conversation history for student + course + unit   const fetchConversationHistory = useCallback(     async (courseId: string, unitId: string) => {       const fetchId = ++latestFetchId.current;       setIsRetrievingHistory(true);        try {         const res = await fetch(           `/api/tutor/history/${encodeURIComponent(user.id)}/${encodeURIComponent(courseId)}/${encodeURIComponent(             unitId           )}`,           {             headers: {               'x-user-id': user.id,               'x-user-role': user.role,             },           }         );          if (!res.ok) {           throw new Error(`HTTP ${res.status}`);         }          const data = await res.json();          // Discard stale response if the user has switched course or unit in the meantime         if (fetchId !== latestFetchId.current) return;          if (data.success && Array.isArray(data.messages) && data.messages.length > 0) {           setMessages(data.messages);         } else {           setMessages([getWelcomeMessage(course, unitId)]);         }       } catch (_err) {         if (fetchId !== latestFetchId.current) return;         // Retain fresh default welcome on retrieval failure without deleting data         setMessages([getWelcomeMessage(course, unitId)]);       } finally {         if (fetchId === latestFetchId.current) {           setIsRetrievingHistory(false);         }       }     },     [user.id, user.role, course, getWelcomeMessage]   );    // Load history whenever student, course, or unit changes   useEffect(() => {     fetchConversationHistory(course.id, selectedUnitId);   }, [course.id, selectedUnitId, fetchConversationHistory]);    // Handle auto-fill prompt from external components (e.g. "Ask Tutor" buttons)   useEffect(() => {     if (initialPrompt) {       setInputQuery(initialPrompt);       if (onClearInitialPrompt) onClearInitialPrompt();     }   }, [initialPrompt, onClearInitialPrompt]);    // Auto-scroll to latest message   useEffect(() => {     if (!isRetrievingHistory) {       messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });     }   }, [messages, activePipelineSteps, isLoading, isRetrievingHistory]);    const handleCopy = (text: string, id: string) => {     navigator.clipboard.writeText(text);     setCopiedId(id);     setTimeout(() => setCopiedId(null), 2000);   };    // Helper to persist message directly to backend   const persistMessage = async (courseId: string, unitId: string, msg: ChatMessage) => {     try {       await fetch('/api/tutor/history', {         method: 'POST',         headers: {           'Content-Type': 'application/json',           'x-user-id': user.id,           'x-user-role': user.role,         },         body: JSON.stringify({           studentId: user.id,           courseId,           unitId,           message: msg,         }),       });     } catch (_err) {       // Background save error handled safely     }   };    const handleSendMessage = async (e?: React.FormEvent, customQuery?: string) => {     if (e) e.preventDefault();     const queryToSend = (customQuery || inputQuery).trim();     if (!queryToSend || isLoading || isRetrievingHistory) return;      // Pin scope parameters at the exact moment of request     const targetCourseId = course.id;     const targetCourseCode = course.code;     const targetCourseName = course.name;     const targetUnitId = selectedUnitId;      const userMsg: ChatMessage = {       id: `msg-u-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,       role: 'user',       content: queryToSend,       timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),     };      // Optimistically update message stream     setMessages((prev) => [...prev, userMsg]);     setInputQuery('');     setIsLoading(true);      // Persist user message to backend immediately     persistMessage(targetCourseId, targetUnitId, userMsg);      // Initial coordination trace animation     setActivePipelineSteps([       { step: 'Analysing Student Request', description: `Evaluating query: "${queryToSend.slice(0, 60)}"`, status: 'running' },     ]);      // Extract unit & syllabus topics     const activeUnit = course.units.find((u) => u.id === targetUnitId);     const unitTitle = activeUnit ? `Unit ${activeUnit.unitNumber}: ${activeUnit.title}` : 'All Units';     const syllabusTopics = activeUnit       ? activeUnit.topics.map((t) => t.title)       : course.units.flatMap((u) => u.topics.map((t) => t.title));      try {       const res = await fetch('/api/agent/coordinate', {         method: 'POST',         headers: { 'Content-Type': 'application/json' },         body: JSON.stringify({           query: queryToSend,           courseName: targetCourseName,           courseCode: targetCourseCode,           unitTitle,           syllabusTopics,         }),       });        const data = await res.json();        if (data.steps) {         setActivePipelineSteps(data.steps);       }        const assistantMsg: ChatMessage = {         id: `msg-a-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,         role: 'assistant',         content: data.response,         steps: data.steps,         selectedAgent: data.selectedAgent,         timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),       };        // Always persist to backend under target scope       persistMessage(targetCourseId, targetUnitId, assistantMsg);        // Only append to active UI stream if user hasn't switched away to another course or unit       if (         currentScopeRef.current.courseId === targetCourseId &&         currentScopeRef.current.unitId === targetUnitId       ) {         setMessages((prev) => [...prev, assistantMsg]);       }     } catch (_err) {       // Offline fallback       const assistantMsg: ChatMessage = {         id: `msg-a-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,         role: 'assistant',         content: `### ${targetCourseName} ΓÇö Conceptual Walkthrough\n\n**Regarding:** ${queryToSend}\n\n**1. Theoretical Formulation:**\nIn ${targetCourseName}, this concept satisfies core algorithmic invariants defined in your curriculum.\n\n**2. Key Properties:**\n- Analyzed under asymptotic notation (Big-O).\n- Designed for predictable memory and pointer navigation.\n\n**3. Check Understanding:**\nWould you like a diagnostic quiz to verify your comprehension?`,         timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),       };        persistMessage(targetCourseId, targetUnitId, assistantMsg);        if (         currentScopeRef.current.courseId === targetCourseId &&         currentScopeRef.current.unitId === targetUnitId       ) {         setMessages((prev) => [...prev, assistantMsg]);       }     } finally {       setIsLoading(false);       setActivePipelineSteps([]);     }   };    // Clear conversation with backend synchronization   const handleConfirmClearChat = async () => {     setIsClearing(true);     try {       await fetch(         `/api/tutor/history/${encodeURIComponent(user.id)}/${encodeURIComponent(course.id)}/${encodeURIComponent(           selectedUnitId         )}`,         {           method: 'DELETE',           headers: {             'x-user-id': user.id,             'x-user-role': user.role,           },         }       );     } catch (_err) {}      setMessages([getWelcomeMessage(course, selectedUnitId)]);     setActivePipelineSteps([]);     setIsClearing(false);     setIsClearModalOpen(false);   };    const activeUnit = course.units.find((u) => u.id === selectedUnitId);   const activeUnitLabel = activeUnit ? `Unit ${activeUnit.unitNumber}: ${activeUnit.title}` : 'All Units';    return (     <div className="flex flex-col h-[calc(100vh-140px)] bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">       {/* 1. Header (Panel 4 from Reference Concept) */}       <div className="p-4 px-6 border-b border-slate-200 bg-white flex flex-wrap items-center justify-between gap-4 shrink-0">         <div>           <div className="flex items-center gap-2">             <h1 className="text-xl font-bold text-slate-900 tracking-tight">AI Tutor</h1>             <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">               {course.code}             </span>             <span className="text-[11px] text-slate-400 font-mono hidden sm:inline">ΓÇó {activeUnitLabel}</span>           </div>           <p className="text-xs text-slate-500 mt-0.5">             Ask any academic question from your syllabus. History is automatically saved per unit.           </p>         </div>          {/* Unit Selector & Actions */}         <div className="flex items-center gap-2">           <div className="flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 shadow-2xs">             <Layers className="w-3.5 h-3.5 text-blue-600 shrink-0" />             <select               value={selectedUnitId}               onChange={(e) => setSelectedUnitId(e.target.value)}               disabled={isLoading || isRetrievingHistory}               className="bg-transparent text-xs text-slate-800 font-semibold focus:outline-none cursor-pointer disabled:opacity-60"             >               <option value="all">All Syllabus Units</option>               {course.units.map((u) => (                 <option key={u.id} value={u.id}>                   Unit {u.unitNumber}: {u.title}                 </option>               ))}             </select>           </div>            <button             type="button"             onClick={() => setIsClearModalOpen(true)}             disabled={isLoading || isRetrievingHistory}             className="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-600 hover:text-red-600 hover:bg-red-50 border border-slate-200 transition-colors disabled:opacity-50"             title="Start new conversation and clear unit history"           >             <RotateCcw className="w-3.5 h-3.5 text-slate-400" />             <span>New Chat</span>           </button>         </div>       </div>        {/* 2. Messages Stream */}       <div className="flex-1 overflow-y-auto p-4 md:p-6 space-y-6 bg-[#F8FAFC]/60">         <div className="max-w-4xl lg:max-w-5xl xl:max-w-6xl w-full mx-auto space-y-6">           {/* Loading Previous Messages Indicator */}           {isRetrievingHistory ? (             <div className="flex flex-col items-center justify-center py-20 text-center space-y-3">               <div className="w-10 h-10 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600">                 <Loader2 className="w-5 h-5 animate-spin" />               </div>               <div>                 <p className="text-xs font-semibold text-slate-800">Restoring Saved Conversation</p>                 <p className="text-[11px] text-slate-400 mt-0.5">                   Loading history for {course.code} ({activeUnitLabel})...                 </p>               </div>             </div>           ) : (             messages.map((msg) => (               <div                 key={msg.id}                 className={`flex items-start gap-3 w-full ${                   msg.role === 'user' ? 'justify-end' : ''                 }`}               >                 {/* User Message */}                 {msg.role === 'user' ? (                   <div className="flex items-start gap-2.5 sm:gap-3 max-w-xl sm:max-w-2xl lg:max-w-3xl ml-auto flex-row-reverse">                     <div className="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-xs mt-0.5">                       <UserIcon className="w-4 h-4" />                     </div>                     <div className="bg-blue-50 border border-blue-200 text-blue-950 p-4 sm:p-5 rounded-2xl rounded-tr-xs shadow-2xs text-xs sm:text-sm leading-relaxed">                       <p className="whitespace-pre-wrap">{msg.content}</p>                       <span className="text-[10px] text-blue-500 font-mono block text-right mt-1.5">{msg.timestamp}</span>                     </div>                   </div>                 ) : (                   /* Assistant Message: Expands across the balanced centered container */                   <div className="flex items-start gap-3 sm:gap-3.5 w-full">                     <div className="w-8 h-8 rounded-xl bg-white border border-slate-200 text-blue-600 flex items-center justify-center shrink-0 shadow-xs mt-0.5">                       <BrainCircuit className="w-4 h-4" />                     </div>                      <div className="flex-1 min-w-0 bg-white border border-slate-200/90 rounded-2xl rounded-tl-xs p-5 sm:p-6 shadow-xs text-slate-800">                       {/* Assistant Header Tag */}                       <div className="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">                         <span className="text-[11px] font-bold text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-full border border-blue-200">                           {msg.selectedAgent || 'Academic Tutor Agent'}                         </span>                         <div className="flex items-center gap-2">                           <span className="text-[10px] text-slate-400 font-mono">{msg.timestamp}</span>                           <button                             type="button"                             onClick={() => handleCopy(msg.content, msg.id)}                             className="p-1 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-50 transition-colors"                             title="Copy to clipboard"                           >                             {copiedId === msg.id ? (                               <Check className="w-3.5 h-3.5 text-emerald-600" />                             ) : (                               <Copy className="w-3.5 h-3.5" />                             )}                           </button>                         </div>                       </div>                        {/* Content Rendering with KaTeX and Markdown */}                       <div className="overflow-x-auto">                         <MarkdownRenderer content={msg.content} />                       </div>                        {/* Optional Collapsed Technical Details Section */}                       {msg.steps && msg.steps.length > 0 && (                         <div className="mt-4 pt-3 border-t border-slate-100">                           <button                             type="button"                             onClick={() => toggleTrace(msg.id)}                             className="flex items-center gap-1.5 text-[11px] font-semibold text-slate-500 hover:text-blue-600 transition-colors"                           >                             <span>Multi-Agent Coordination Trace ({msg.steps.length} Stages)</span>                             {expandedTraceIds[msg.id] ? (                               <ChevronUp className="w-3.5 h-3.5" />                             ) : (                               <ChevronDown className="w-3.5 h-3.5" />                             )}                           </button>                            {expandedTraceIds[msg.id] && (                             <div className="mt-3 p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2">                               {msg.steps.map((st, sIdx) => (                                 <div key={sIdx} className="flex items-start gap-2 text-[11px]">                                   <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-1.5 shrink-0" />                                   <div>                                     <strong className="text-slate-800">{st.step}:</strong>{' '}                                     <span className="text-slate-600">{st.description}</span>                                   </div>                                 </div>                               ))}                             </div>                           )}                         </div>                       )}                     </div>                   </div>                 )}               </div>             ))           )}            {/* Live Loading Indicator */}           {isLoading && (             <div className="flex items-start gap-3 w-full">               <div className="w-8 h-8 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-blue-600 shadow-xs shrink-0 mt-0.5">                 <Sparkles className="w-4 h-4 animate-spin text-blue-600" />               </div>               <div className="flex-1 bg-white border border-slate-200 p-4 sm:p-5 rounded-2xl rounded-tl-xs shadow-xs text-xs sm:text-sm text-slate-600 flex items-center gap-3">                 <span className="w-2.5 h-2.5 rounded-full bg-blue-600 animate-ping shrink-0" />                 <span>Coordinating with Academic AI agents and synthesizing syllabus guidance...</span>               </div>             </div>           )}            <div ref={messagesEndRef} />         </div>       </div>        {/* 3. Bottom Input Box */}       <div className="p-4 bg-white border-t border-slate-200 shrink-0">         <div className="max-w-4xl lg:max-w-5xl xl:max-w-6xl w-full mx-auto">           <form onSubmit={handleSendMessage} className="relative flex items-center gap-2">             <input               type="text"               value={inputQuery}               onChange={(e) => setInputQuery(e.target.value)}               disabled={isLoading || isRetrievingHistory}               placeholder={`Ask an academic question about ${course.code} (${activeUnitLabel})...`}               className="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-600 focus:bg-white shadow-2xs transition-all disabled:opacity-60"             />              <button               type="submit"               disabled={!inputQuery.trim() || isLoading || isRetrievingHistory}               className="p-3 bg-blue-600 hover:bg-blue-700 disabled:opacity-40 text-white rounded-xl shadow-xs transition-colors shrink-0"               aria-label="Send query"             >               <Send className="w-4 h-4" />             </button>           </form>            {/* Quick prompt suggestions */}           <div className="mt-2.5 flex items-center gap-2 overflow-x-auto text-[11px] text-slate-500 pb-0.5">             <span className="font-semibold text-slate-400 shrink-0">Try asking:</span>             {[               'Explain core concepts with clear step-by-step examples',               'Derive key formulas and state computational bounds',               'Provide a sample practice problem with detailed analysis',             ].map((prompt, idx) => (               <button                 key={idx}                 type="button"                 onClick={() => handleSendMessage(undefined, prompt)}                 disabled={isLoading || isRetrievingHistory}                 className="px-2.5 py-1 rounded-lg bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200/80 whitespace-nowrap transition-colors disabled:opacity-50"               >                 {prompt}               </button>             ))}           </div>         </div>       </div>        {/* 4. Clear Conversation Confirmation Modal */}       {isClearModalOpen && (         <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm animate-in fade-in duration-200">           <div className="bg-white border border-slate-200 rounded-2xl w-full max-w-md p-6 shadow-2xl relative">             <button               type="button"               onClick={() => setIsClearModalOpen(false)}               className="absolute top-4 right-4 p-1.5 rounded-lg bg-slate-100 text-slate-400 hover:text-slate-700 transition-colors"             >               <X className="w-4 h-4" />             </button>              <div className="flex items-center gap-3 mb-3">               <div className="w-10 h-10 rounded-xl bg-red-50 border border-red-100 flex items-center justify-center text-red-600">                 <AlertTriangle className="w-5 h-5" />               </div>               <div>                 <h3 className="text-base font-bold text-slate-900">Clear Conversation History?</h3>                 <p className="text-xs text-slate-500 font-mono">                   {course.code} ΓÇó {activeUnitLabel}                 </p>               </div>             </div>              <p className="text-xs text-slate-600 leading-relaxed mb-5">               This will permanently delete the saved conversation history for this specific unit. Other units and subjects will remain unaffected.             </p>              <div className="flex items-center justify-end gap-2.5">               <button                 type="button"                 onClick={() => setIsClearModalOpen(false)}                 disabled={isClearing}                 className="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200 transition-colors"               >                 Cancel               </button>               <button                 type="button"                 onClick={handleConfirmClearChat}                 disabled={isClearing}                 className="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-red-600 hover:bg-red-700 shadow-xs transition-colors flex items-center gap-1.5 disabled:opacity-50"               >                 {isClearing ? <Loader2 className="w-3.5 h-3.5 animate-spin" /> : <Trash2 className="w-3.5 h-3.5" />}                 <span>Clear History</span>               </button>             </div>           </div>         </div>       )}     </div>   ); };