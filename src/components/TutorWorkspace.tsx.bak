import React, { useState, useRef, useEffect } from 'react'; import { Course, ChatMessage, AgentExecutionStep } from '../types'; import { MarkdownRenderer } from './MarkdownRenderer'; import {   Send,   BrainCircuit,   Bot,   User,   Trash2,   Copy,   Check,   Sparkles,   HelpCircle,   Code2,   ArrowRight,   ShieldAlert,   ChevronDown,   ChevronUp,   FileQuestion,   Layers, } from 'lucide-react';  interface TutorWorkspaceProps {   course: Course;   initialPrompt?: string;   onClearInitialPrompt?: () => void;   onNavigateToQuiz?: () => void; }  export const TutorWorkspace: React.FC<TutorWorkspaceProps> = ({   course,   initialPrompt,   onClearInitialPrompt,   onNavigateToQuiz, }) => {   const [messages, setMessages] = useState<ChatMessage[]>([     {       id: 'welcome-msg',       role: 'assistant',       content: `Welcome to EDUAGENT! I am your Academic Tutor Agent, coordinated under **${course.code}: ${course.name}**.\n\nAll explanations are grounded directly in your syllabus. How can I assist your study today?`,       timestamp: 'Just now',     },   ]);    const [inputQuery, setInputQuery] = useState(initialPrompt || '');   const [selectedUnitId, setSelectedUnitId] = useState<string>('all');   const [isLoading, setIsLoading] = useState(false);   const [copiedId, setCopiedId] = useState<string | null>(null);   const [activePipelineSteps, setActivePipelineSteps] = useState<AgentExecutionStep[]>([]);   const [expandedTraceIds, setExpandedTraceIds] = useState<Record<string, boolean>>({});   const messagesEndRef = useRef<HTMLDivElement>(null);    const toggleTrace = (msgId: string) => {     setExpandedTraceIds((prev) => ({ ...prev, [msgId]: !prev[msgId] }));   };    // Auto-fill initial prompt if sent from other views   useEffect(() => {     if (initialPrompt) {       setInputQuery(initialPrompt);       if (onClearInitialPrompt) onClearInitialPrompt();     }   }, [initialPrompt, onClearInitialPrompt]);    // Reset tutor conversation when switching course   useEffect(() => {     setSelectedUnitId('all');     setMessages([       {         id: `welcome-msg-${course.id}`,         role: 'assistant',         content: `Welcome to EDUAGENT! I am your Academic Tutor Agent, coordinated under **${course.code}: ${course.name}**.\n\nAll explanations are grounded directly in your syllabus. How can I assist your study today?`,         timestamp: 'Just now',       },     ]);   }, [course.id, course.code, course.name]);    // Auto scroll to latest message   useEffect(() => {     messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });   }, [messages, activePipelineSteps, isLoading]);    const handleCopy = (text: string, id: string) => {     navigator.clipboard.writeText(text);     setCopiedId(id);     setTimeout(() => setCopiedId(null), 2000);   };    const handleSendMessage = async (e?: React.FormEvent, customQuery?: string) => {     if (e) e.preventDefault();     const queryToSend = (customQuery || inputQuery).trim();     if (!queryToSend || isLoading) return;      const userMsg: ChatMessage = {       id: `msg-${Date.now()}`,       role: 'user',       content: queryToSend,       timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),     };      setMessages((prev) => [...prev, userMsg]);     setInputQuery('');     setIsLoading(true);      // Initial coordination trace animation     setActivePipelineSteps([       { step: 'Analysing Student Request', description: `Evaluating query: "${queryToSend.slice(0, 60)}"`, status: 'running' },     ]);      // Extract unit & syllabus topics     const activeUnit = course.units.find((u) => u.id === selectedUnitId);     const unitTitle = activeUnit ? `Unit ${activeUnit.unitNumber}: ${activeUnit.title}` : 'All Units';     const syllabusTopics = activeUnit       ? activeUnit.topics.map((t) => t.title)       : course.units.flatMap((u) => u.topics.map((t) => t.title));      try {       const res = await fetch('/api/agent/coordinate', {         method: 'POST',         headers: { 'Content-Type': 'application/json' },         body: JSON.stringify({           query: queryToSend,           courseName: course.name,           courseCode: course.code,           unitTitle,           syllabusTopics,         }),       });        const data = await res.json();        if (data.steps) {         setActivePipelineSteps(data.steps);       }        const assistantMsg: ChatMessage = {         id: `msg-resp-${Date.now()}`,         role: 'assistant',         content: data.response,         steps: data.steps,         selectedAgent: data.selectedAgent,         timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),       };        setMessages((prev) => [...prev, assistantMsg]);     } catch (_err) {       // Offline fallback       const assistantMsg: ChatMessage = {         id: `msg-resp-${Date.now()}`,         role: 'assistant',         content: `### ${course.name} ΓÇö Conceptual Walkthrough\n\n**Regarding:** ${queryToSend}\n\n**1. Theoretical Formulation:**\nIn ${course.name}, this concept satisfies core algorithmic invariants defined in your curriculum.\n\n**2. Key Properties:**\n- Analyzed under asymptotic notation (Big-O).\n- Designed for predictable memory and pointer navigation.\n\n**3. Check Understanding:**\nWould you like a diagnostic quiz to verify your comprehension?`,         timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),       };       setMessages((prev) => [...prev, assistantMsg]);     } finally {       setIsLoading(false);       setActivePipelineSteps([]);     }   };    const handleClearChat = () => {     setMessages([       {         id: 'welcome-reset',         role: 'assistant',         content: `Conversation refreshed. Academic context remains synchronized with **${course.code}: ${course.name}**.`,         timestamp: 'Just now',       },     ]);     setActivePipelineSteps([]);   };    return (     <div className="flex flex-col h-[calc(100vh-140px)] bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">       {/* 1. Header (Panel 4 from Reference Concept) */}       <div className="p-4 px-6 border-b border-slate-200 bg-white flex flex-wrap items-center justify-between gap-4 shrink-0">         <div>           <div className="flex items-center gap-2">             <h1 className="text-xl font-bold text-slate-900 tracking-tight">AI Tutor</h1>             <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">               {course.code}             </span>           </div>           <p className="text-xs text-slate-500 mt-0.5">             Ask any academic question from your syllabus           </p>         </div>          {/* Unit Selector & Actions */}         <div className="flex items-center gap-2">           <div className="flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 shadow-2xs">             <Layers className="w-3.5 h-3.5 text-blue-600 shrink-0" />             <select               value={selectedUnitId}               onChange={(e) => setSelectedUnitId(e.target.value)}               className="bg-transparent text-xs text-slate-800 font-semibold focus:outline-none cursor-pointer"             >               <option value="all">All Syllabus Units</option>               {course.units.map((u) => (                 <option key={u.id} value={u.id}>                   Unit {u.unitNumber}: {u.title}                 </option>               ))}             </select>           </div>            <button             type="button"             onClick={handleClearChat}             className="p-2 rounded-xl text-slate-400 hover:text-red-600 hover:bg-red-50 border border-slate-200 transition-colors"             title="Clear Chat History"           >             <Trash2 className="w-4 h-4" />           </button>         </div>       </div>        {/* 2. Messages Stream */}       <div className="flex-1 overflow-y-auto p-4 md:p-6 space-y-6 bg-[#F8FAFC]/60">         {messages.map((msg) => (           <div             key={msg.id}             className={`flex items-start gap-3 max-w-3xl ${               msg.role === 'user' ? 'ml-auto flex-row-reverse' : ''             }`}           >             {/* Avatar */}             <div               className={`w-8 h-8 rounded-xl flex items-center justify-center shrink-0 shadow-2xs ${                 msg.role === 'user'                   ? 'bg-blue-600 text-white'                   : 'bg-white border border-slate-200 text-blue-600'               }`}             >               {msg.role === 'user' ? <User className="w-4 h-4" /> : <BrainCircuit className="w-4 h-4" />}             </div>              {/* Bubble */}             <div className="flex-1 min-w-0">               <div                 className={`p-4 sm:p-5 rounded-2xl text-xs sm:text-sm leading-relaxed ${                   msg.role === 'user'                     ? 'bg-blue-50 border border-blue-200 text-blue-950 rounded-tr-xs shadow-2xs'                     : 'bg-white border border-slate-200 text-slate-800 rounded-tl-xs shadow-xs'                 }`}               >                 {/* Assistant Header Tag */}                 {msg.role === 'assistant' && (                   <div className="flex items-center justify-between pb-2.5 mb-3 border-b border-slate-100">                     <span className="text-[11px] font-bold text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-full border border-blue-200">                       {msg.selectedAgent || 'Academic Tutor Agent'}                     </span>                     <div className="flex items-center gap-2">                       <span className="text-[10px] text-slate-400 font-mono">{msg.timestamp}</span>                       <button                         type="button"                         onClick={() => handleCopy(msg.content, msg.id)}                         className="p-1 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-50 transition-colors"                         title="Copy to clipboard"                       >                         {copiedId === msg.id ? (                           <Check className="w-3.5 h-3.5 text-emerald-600" />                         ) : (                           <Copy className="w-3.5 h-3.5" />                         )}                       </button>                     </div>                   </div>                 )}                  {/* Content Rendering with KaTeX and Markdown */}                 <MarkdownRenderer content={msg.content} />                  {/* Optional Collapsed Technical Details Section */}                 {msg.role === 'assistant' && msg.steps && msg.steps.length > 0 && (                   <div className="mt-4 pt-3 border-t border-slate-100">                     <button                       type="button"                       onClick={() => toggleTrace(msg.id)}                       className="flex items-center gap-1.5 text-[11px] font-semibold text-slate-500 hover:text-blue-600 transition-colors"                     >                       <span>Multi-Agent Coordination Trace ({msg.steps.length} Stages)</span>                       {expandedTraceIds[msg.id] ? (                         <ChevronUp className="w-3.5 h-3.5" />                       ) : (                         <ChevronDown className="w-3.5 h-3.5" />                       )}                     </button>                      {expandedTraceIds[msg.id] && (                       <div className="mt-3 p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2">                         {msg.steps.map((st, sIdx) => (                           <div key={sIdx} className="flex items-start gap-2 text-[11px]">                             <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-1.5 shrink-0" />                             <div>                               <strong className="text-slate-800">{st.step}:</strong>{' '}                               <span className="text-slate-600">{st.description}</span>                             </div>                           </div>                         ))}                       </div>                     )}                   </div>                 )}               </div>             </div>           </div>         ))}          {/* Live Loading Indicator */}         {isLoading && (           <div className="flex items-start gap-3 max-w-2xl">             <div className="w-8 h-8 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-blue-600 shadow-2xs">               <Sparkles className="w-4 h-4 animate-spin text-blue-600" />             </div>             <div className="bg-white border border-slate-200 p-4 rounded-2xl rounded-tl-xs shadow-xs text-xs text-slate-600 flex items-center gap-3">               <span className="w-2 h-2 rounded-full bg-blue-600 animate-ping" />               <span>Coordinating with Academic AI agents and synthesizing syllabus guidance...</span>             </div>           </div>         )}          <div ref={messagesEndRef} />       </div>        {/* 3. Bottom Input Box (Panel 4) */}       <div className="p-4 bg-white border-t border-slate-200">         <form onSubmit={handleSendMessage} className="relative flex items-center gap-2">           <input             type="text"             value={inputQuery}             onChange={(e) => setInputQuery(e.target.value)}             disabled={isLoading}             placeholder="Ask a question about your subjects..."             className="flex-1 bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-blue-600 focus:bg-white shadow-2xs transition-all"           />            <button             type="submit"             disabled={!inputQuery.trim() || isLoading}             className="p-3 bg-blue-600 hover:bg-blue-700 disabled:opacity-40 text-white rounded-xl shadow-xs transition-colors shrink-0"             aria-label="Send query"           >             <Send className="w-4 h-4" />           </button>         </form>          {/* Quick prompt suggestions */}         <div className="mt-2.5 flex items-center gap-2 overflow-x-auto text-[11px] text-slate-500 pb-0.5">           <span className="font-semibold text-slate-400 shrink-0">Try asking:</span>           {[             'Explain process scheduling in Operating Systems with types',             'Derive AVL Tree rotations and height bounds',             'Compare BCNF vs 3NF with decomposition examples',           ].map((prompt, idx) => (             <button               key={idx}               type="button"               onClick={() => handleSendMessage(undefined, prompt)}               className="px-2.5 py-1 rounded-lg bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 border border-slate-200/80 whitespace-nowrap transition-colors"             >               {prompt}             </button>           ))}         </div>       </div>     </div>   ); };